# Bu dosya bir ŞABLONDUR — gerçek değer YAZILMAZ.
# Kopyala:  cp .env.local.example .env.local   ve .env.local'i doldur.
# .env.local git tarafından yok sayılır; bu dosya ise commit'lenebilir olmalı.
#
# NOT (2026-08-10): burada daha önce GERÇEK anahtarlar duruyordu, service-role
# JWT'si dahil. Git takip etmiyordu, yani sızmamıştı — ama adı "example" olan
# bir dosya normalde commit'lenir ve tek bir `git add -f` yeterdi.

# ── Supabase ────────────────────────────────────────────────────────────────
# Panel → Project Settings → API
# İlk ikisi TARAYICIYA GİDER (NEXT_PUBLIC_), gizli değildir; korumayı RLS sağlar.
NEXT_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# ⚠ SUNUCUYA ÖZEL — RLS'İ TAMAMEN BAYPAS EDER. Asla NEXT_PUBLIC_ yapma, asla
# istemci koduna sokma. Sızarsa Supabase panelinden derhal rotate et.
SUPABASE_SERVICE_KEY=<service-role-key>

# ── Site ────────────────────────────────────────────────────────────────────
# E-posta onay/şifre sıfırlama linkleri buradan üretilir; yereldeyse
# http://localhost:3000 yaz, yoksa linkler üretime gider.
NEXT_PUBLIC_SITE_URL=https://basementonfire.com

# ── Yönetim ─────────────────────────────────────────────────────────────────
# Virgülle ayrılmış kullanıcı adları. users.is_admin=true ile birlikte çalışır
# (ikisinden biri yeterli) — bkz. lib/supabase/server.ts isAdmin().
ADMIN_USERNAMES=<kullanici1,kullanici2>

# ── Üçüncü taraf ────────────────────────────────────────────────────────────
# GIF arama (app/api/giphy). Yoksa GIF seçici çalışmaz, gerisi etkilenmez.
GIPHY_API_KEY=<giphy-key>

# Google Analytics ölçüm kimliği. Yoksa gtag hiç yüklenmez (site çalışır).
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Netlify tarafı (yerelde GEREKMEZ) ───────────────────────────────────────
# Deploy süpürgesinin yetkisi. Netlify → Environment variables, scope: Functions.
# Tanımlı değilse süpürge fail-closed davranır, hiç çalışmaz.
WARM_SECRET=<rastgele-uzun-dize>

# IndexNow elle tetikleme ucunun yetkisi (app/api/indexnow).
INDEXNOW_ADMIN_TOKEN=<rastgele-uzun-dize>

# ── Özellik bayrakları ──────────────────────────────────────────────────────
# Eşleştirme özelliği. Şu an KAPALI (bilerek gizli) — bkz. lib/features.ts.
NEXT_PUBLIC_MATCHING_ENABLED=false
